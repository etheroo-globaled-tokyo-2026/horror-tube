FIGHT_MEDIA_SPACES_ACCESS_KEY_ID=
# 1password: op://Private/Horror Tube fight media/spaces_secret
FIGHT_MEDIA_SPACES_SECRET=
# 1password: op://Private/Horror Tube fight media/spaces_bucket
FIGHT_MEDIA_SPACES_BUCKET=
