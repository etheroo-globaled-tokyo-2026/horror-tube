# After a workspace reset, this file is the source for .env.
# Copy it to .env. The comment above each variable is how to fill that value.
# A `# 1password: op://...` comment is a path: run `op read` once and write the
# value into .env. Later commands read .env.

# Shared secrets — ask another developer for these (empty values only here).
# PRIVATE_KEY — op://Private/Horror Tube Sepolia burner/private key — ENS bootstrap/admin
# ROSTER_PRIVATE_KEY — op://Private/Horror Tube Sepolia roster writer/private key — ENS look/brief/icon
# AGENT_PRIVATE_KEY — op://Private/Horror Tube Sepolia agent writer/private key — ENS status/injuries
# SPACES_ACCESS_KEY_ID — op://Private/ETHTokyo DigitalOcean/spaces_access_key_id — icons bucket only
# SPACES_SECRET — op://Private/ETHTokyo DigitalOcean/spaces_secret — icons bucket only
# FIGHT_MEDIA_SPACES_ACCESS_KEY_ID — op://Private/Horror Tube fight media/spaces_access_key_id — fight-media bucket only
# FIGHT_MEDIA_SPACES_SECRET — op://Private/Horror Tube fight media/spaces_secret — fight-media bucket only
# FIGHT_MEDIA_SPACES_BUCKET — op://Private/Horror Tube fight media/spaces_bucket — fight-media bucket name
# FIGHT_MEDIA_SPACES_CDN_HOST — op://Private/Horror Tube fight media/spaces_cdn_host — fight-media CDN host
# FIGHT_MEDIA_SPACES_ENDPOINT — op://Private/Horror Tube fight media/spaces_endpoint — fight-media Spaces endpoint
# TOGETHER_API_KEY — op://Private/together/credential — Together image API
# FAL_KEY — op://Private/Horror Tube fal/credential — fal video API
# WORLD_ID_APP_ID — op://Private/Horror Tube World ID/app_id — World ID app id
# WORLD_ID_RP_ID — op://Private/Horror Tube World ID/rp_id — World ID RP id
# WORLD_ID_SIGNING_KEY — op://Private/Horror Tube World ID/signing_key — World ID request signing
# WORLD_ID_STAGING_TOKEN — op://Private/Horror Tube World ID/staging_verification_token — staging verify header; required when WORLD_ID_ENVIRONMENT=staging. Share with developers who deploy the game app.
# SHINAMI_ACCESS_KEY — op://Private/Horror Tube Shinami/credential — Invisible Wallets
# WALLET_SECRET_PEPPER — op://Private/Horror Tube wallet pepper/password — server only; losing it loses every Invisible Wallet
# SUI_ADMIN_PRIVATE_KEY — op://Private/Horror Tube Sui admin/private key — Sui betting publisher and AdminCap; laptop only
# SUI_OPERATOR_PRIVATE_KEY — op://Private/Horror Tube Sui operator/private key — Sui betting operator; server
# DATABASE_URL — no 1Password item was found — Postgres public URI (password inside)
#
# Do not share:
# DigitalOcean API token — op://Personal/DigitalOcean IRC/api_key — whole DO account
# TF_STATE_SPACES_ACCESS_KEY_ID — no 1Password item was found — Spaces key horror-tube-tfstate (fullaccess); not an App Platform variable; not the icons key
# TF_STATE_SPACES_SECRET — no 1Password item was found — Spaces key horror-tube-tfstate (fullaccess); not an App Platform variable; not the icons key

# no 1Password item was found
# Required. One lowercase label, not a full name.
ENS_LABEL=
# 1password: op://Private/Horror Tube Sepolia burner/private key
# Bootstrap/admin: parent register, subname register, grantSetterRoles. Keep ALL_ROLES.
PRIVATE_KEY=
# 1password: op://Private/Horror Tube Sepolia roster writer/private key
# Restricted roster writer: look, brief, icon only. Must not equal PRIVATE_KEY.
ROSTER_PRIVATE_KEY=
# 1password: op://Private/Horror Tube Sepolia agent writer/private key
# Restricted agent/fight writer: status, injuries only. Must not equal PRIVATE_KEY.
# Also signs BattleBetting openBattle / placeBet on the game node (needs OPERATOR_ROLE for open).
AGENT_PRIVATE_KEY=
# no 1Password item was found
SEPOLIA_RPC_URL=
# Required. Sepolia RPC the web game calls from the browser. It ships in the page, so use a public keyless one.
VITE_SEPOLIA_RPC_URL=
# no 1Password item was found
PAYMENT_TOKEN=
# no 1Password item was found
DURATION_SECONDS=
# no 1Password item was found; Spaces key name horror-tube-tfstate; fullaccess; state bucket horror-tube-tfstate-sgp1-k7p2; export as AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY; unset AWS_PROFILE; do not use SPACES_ACCESS_KEY_ID for state (icons only)
TF_STATE_SPACES_ACCESS_KEY_ID=
# no 1Password item was found; Spaces key name horror-tube-tfstate; fullaccess; state bucket horror-tube-tfstate-sgp1-k7p2; export as AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY; unset AWS_PROFILE; do not use SPACES_ACCESS_KEY_ID for state (icons only)
TF_STATE_SPACES_SECRET=
# 1password: op://Private/ETHTokyo DigitalOcean/spaces_access_key_id
SPACES_ACCESS_KEY_ID=
# 1password: op://Private/ETHTokyo DigitalOcean/spaces_secret
SPACES_SECRET=
# no 1Password item was found
SPACES_BUCKET=
# no 1Password item was found
SPACES_CDN_HOST=
# no 1Password item was found
SPACES_ENDPOINT=
# 1password: op://Private/Horror Tube fight media/spaces_access_key_id
FIGHT_MEDIA_SPACES_ACCESS_KEY_ID=
# 1password: op://Private/Horror Tube fight media/spaces_secret
FIGHT_MEDIA_SPACES_SECRET=
# 1password: op://Private/Horror Tube fight media/spaces_bucket
FIGHT_MEDIA_SPACES_BUCKET=
# 1password: op://Private/Horror Tube fight media/spaces_cdn_host
FIGHT_MEDIA_SPACES_CDN_HOST=
# 1password: op://Private/Horror Tube fight media/spaces_endpoint
FIGHT_MEDIA_SPACES_ENDPOINT=
# 1password: op://Private/together/credential
TOGETHER_API_KEY=
# no 1Password item was found
TOGETHER_API_URL=
# no 1Password item was found
TOGETHER_IMAGE_MODEL=
# 1password: op://Private/Horror Tube fal/credential
FAL_KEY=
# no 1Password item was found
# Operator value: minimax/h3-max/text-to-video
FAL_MODEL=
# no 1Password item was found
# Operator value: minimax/h3-max/image-to-video
# Required when RoundState.frameUrl seeds the next bout. Blank is fine for the
# first fight in a chain (text-to-video). Fail closed if a prior frame exists
# and this is blank — do not drop the frame and call text-to-video.
FAL_IMAGE_TO_VIDEO_MODEL=
# Operator value for fal MiniMax H3 Max duration (seconds). OpenAPI range is 5–15.
FIGHT_VIDEO_SECONDS=
# Operator value: 480P | 768P | 1080P
FAL_VIDEO_RESOLUTION=
# Operator value: disabled | balanced | quality
FAL_PROMPT_EXPANSION_MODE=
# Operator value: 21:9 | 16:9 | 4:3 | 1:1 | 3:4 | 9:16
FAL_ASPECT_RATIO=
# Operator value: anthropic | gemini
NARRATION_PROVIDER=
# Operator value: claude-sonnet-5
NARRATION_MODEL=
# 1password: op://Private/Anthropic Api key (hackathon)/credential
ANTHROPIC_API_KEY=
# no 1Password item was found
GEMINI_API_KEY=
# 1password: op://Private/Horror Tube World ID/app_id
WORLD_ID_APP_ID=
# 1password: op://Private/Horror Tube World ID/rp_id
WORLD_ID_RP_ID=
# 1password: op://Private/Horror Tube World ID/signing_key
WORLD_ID_SIGNING_KEY=
# no 1Password item was found
# Operator value: staging. The production app uses the World ID simulator.
WORLD_ID_ENVIRONMENT=
# Required when WORLD_ID_ENVIRONMENT=staging. The Developer Portal shows it once when a
# staging verification window opens; the window and the token end after 24 hours.
# 1password: op://Private/Horror Tube World ID/staging_verification_token
WORLD_ID_STAGING_TOKEN=
# local HTTP port, not stored in 1Password
WORLD_ID_HTTP_PORT=
# Blank uses 8130. Set a port here to override.
DASHBOARD_PORT=
# no 1Password item was found
# App Platform injects GAME_PORT from Terraform game_port. On a laptop, set a free port.
GAME_PORT=
# no 1Password item was found
# Laptop: terraform output database_uri (public). App Platform DATABASE_URL is set
# from the cluster public uri in Terraform (no VPC; private_uri would not resolve).
DATABASE_URL=
# no 1Password item was found
# DigitalOcean Managed Postgres project CA PEM (not a secret key). From the
# databases API GET /v2/databases/{id}/ca (decode the base64 certificate field
# to PEM, or paste that base64). Required for verified TLS; do not set
# NODE_TLS_REJECT_UNAUTHORIZED=0.
DATABASE_CA_CERT=
# no 1Password item was found
# Dev quorum 1, prod 2. Required by @horror-tube/server game loop.
QUORUM_VOTES=
# no 1Password item was found
# Dev and prod 15. Required by @horror-tube/server game loop.
VOTE_COUNTDOWN_SECONDS=
# no 1Password item was found
# Dev and prod 10. Required by @horror-tube/server game loop.
BET_MIN_SECONDS=
# no 1Password item was found
# Dev and prod 300. Required by @horror-tube/server game loop.
VIDEO_TIMEOUT_SECONDS=
# no 1Password item was found
# Dev and prod 8. Required by @horror-tube/server game loop.
SETTLE_SECONDS=
# no 1Password item was found
# 1 skips BattleBetting settlement until that client exists; 0 calls settleBattle.
# Required by @horror-tube/server. Must be exactly 0 or 1.
SKIP_BATTLE_SETTLEMENT=
# no 1Password item was found
# Comma-separated ENS labels for the shared roster (sorted for numeric ids). At least two.
ROSTER_ENS_LABELS=
# BattleBetting deploy: wallet that gets OPERATOR_ROLE (opens and cancels battles)
OPERATOR_ADDRESS=
# BattleBetting deploy: where withdrawn fees go
TREASURY_ADDRESS=
# Fee in basis points, taken from the losing side (200 = 2%). Read by pnpm betting:deploy
BET_FEE_BPS=
# BattleBetting deploy: minimum bet in wei
MIN_BET_WEI=
# BattleBetting deployment that the app and the e2e script use.
# Required by @horror-tube/server for openBattle / placeBet (no fallback address).
BATTLE_BETTING_ADDRESS=
# 1password: op://Private/Horror Tube Shinami/credential
SHINAMI_ACCESS_KEY=
# 1password: op://Private/Horror Tube wallet pepper/password
# If it is lost, every Invisible Wallet is lost.
WALLET_SECRET_PEPPER=
# no 1Password item was found
# Sui testnet Circle USDC. Same type apps/web/wallet.ts uses.
SUI_USDC_TYPE=
# no 1Password item was found
# Printed by pnpm betting:deploy
BETTING_PACKAGE_ID=
# Sui network for betting: testnet
SUI_NETWORK=
# Sui full node gRPC URL: https://fullnode.testnet.sui.io:443
SUI_GRPC_URL=
# Printed by pnpm betting:deploy
BETTING_HOUSE_ID=
# Minimum bet in USDC base units (30000 = 0.03 USDC). Read by pnpm betting:deploy
SUI_MIN_BET=
# 1password: op://Private/Horror Tube Sui admin/private key
# Publisher. Holds AdminCap (deploy makes the package immutable). Funds the e2e wallet. Laptop only.
SUI_ADMIN_PRIVATE_KEY=
# Printed by pnpm betting:deploy
SUI_ADMIN_CAP_ID=
# 1password: op://Private/Horror Tube Sui operator/private key
SUI_OPERATOR_PRIVATE_KEY=
# Printed by pnpm betting:deploy
SUI_OPERATOR_CAP_ID=
# Printed by pnpm betting:deploy. Operator cap held by the admin key, for pnpm betting:e2e
SUI_E2E_OPERATOR_CAP_ID=
# Random secret for the e2e's own Shinami wallet (openssl rand -hex 32). Laptop only; not the players' pepper.
SUI_E2E_WALLET_SECRET=
# Printed by pnpm test-usdc:deploy. Our free testnet USDC; put it in SUI_USDC_TYPE to bet with it
TEST_USDC_TYPE=
# Printed by pnpm test-usdc:deploy. Shared faucet that pnpm test-usdc:mint mints from
TEST_USDC_FAUCET_ID=

