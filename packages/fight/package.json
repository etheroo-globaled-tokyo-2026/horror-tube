{
  "name": "@horror-tube/fight",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./rotation": {
      "types": "./dist/rotation.d.ts",
      "import": "./dist/rotation.js",
      "default": "./dist/rotation.js"
    },
    "./battle-queue": {
      "types": "./dist/battle-queue.d.ts",
      "import": "./dist/battle-queue.js",
      "default": "./dist/battle-queue.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "demo": "tsx src/demo.ts",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "@fal-ai/client": "^1.9.1",
    "@google/genai": "^1.46.0",
    "@horror-tube/fight-media": "workspace:*",
    "dotenv": "^18.0.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "tsx": "^4.23.15",
    "typescript": "7.0.2"
  }
}
