#!/usr/bin/env python3
"""AWS credential_process for DigitalOcean Spaces.

Reads SPACES_ACCESS_KEY_ID and SPACES_SECRET from the repo .env.
Does not call 1Password.
"""

import json
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
ENV_PATH = ROOT / ".env"
EXAMPLE_PATH = ROOT / ".env.example"
REQUIRED = ("SPACES_ACCESS_KEY_ID", "SPACES_SECRET")


def parse_env(text: str) -> dict[str, str]:
    values: dict[str, str] = {}
    for raw in text.splitlines():
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        if line.startswith("export "):
            line = line[len("export ") :].strip()
        if "=" not in line:
            continue
        key, value = line.split("=", 1)
        key = key.strip()
        value = value.strip()
        if len(value) >= 2 and value[0] == value[-1] and value[0] in "'\"":
            value = value[1:-1]
        values[key] = value
    return values


def fail(message: str) -> None:
    print(message, file=sys.stderr)
    raise SystemExit(1)


def credentials_from_env_text(text: str, env_path: Path, example_path: Path) -> dict[str, str]:
    values = parse_env(text)
    missing = [key for key in REQUIRED if values.get(key, "").strip() == ""]
    if missing:
        names = ", ".join(missing)
        verb = "is" if len(missing) == 1 else "are"
        fail(
            f"{names} {verb} required in {env_path}. "
            f"See {example_path}: the `# 1password: op://...` comment above each name "
            "is the 1Password path. Run `op read` once for that path and write the "
            "value into .env. Later commands read .env."
        )
    return {
        "Version": 1,
        "AccessKeyId": values["SPACES_ACCESS_KEY_ID"],
        "SecretAccessKey": values["SPACES_SECRET"],
    }


def load_credentials(env_path: Path, example_path: Path) -> dict[str, str]:
    if not env_path.is_file():
        fail(
            f".env is missing at {env_path}. "
            f"Create it from {example_path}. "
            "Each `# 1password: op://...` comment is the 1Password path for the "
            "variable under it. Run `op read` once per path and write the value "
            "into .env. Later commands read .env."
        )
    return credentials_from_env_text(env_path.read_text(), env_path, example_path)


def main() -> None:
    payload = load_credentials(ENV_PATH, EXAMPLE_PATH)
    json.dump(payload, sys.stdout)
    sys.stdout.write("\n")


if __name__ == "__main__":
    main()
