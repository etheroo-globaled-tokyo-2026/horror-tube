{
  "name": "horror-tube",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "oxlint",
    "format": "oxfmt",
    "ens:check": "pnpm --filter @horror-tube/ens check",
    "ens:roles": "pnpm --filter @horror-tube/ens roles",
    "ens:register": "pnpm --filter @horror-tube/ens register",
    "ens:subnames": "pnpm --filter @horror-tube/ens subnames",
    "dashboard": "pnpm --filter @horror-tube/ens dashboard",
    "betting:deploy": "pnpm --filter @horror-tube/betting run deploy",
    "betting:pool": "pnpm --filter @horror-tube/betting run pool",
    "betting:e2e": "pnpm --filter @horror-tube/betting run e2e",
    "test-usdc:deploy": "pnpm --filter @horror-tube/test-usdc run deploy",
    "test-usdc:mint": "pnpm --filter @horror-tube/test-usdc run mint",
    "test-usdc:send": "pnpm --filter @horror-tube/test-usdc run send",
    "test-usdc:accounts": "pnpm --filter @horror-tube/test-usdc run accounts"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.85.0",
    "oxfmt": "0.70.0",
    "oxlint": "1.85.0",
    "turbo": "^2.11.4"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.6.0"
}
