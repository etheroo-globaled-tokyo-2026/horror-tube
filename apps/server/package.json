{
  "name": "@horror-tube/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "migrate": "tsx src/migrate-cli.ts",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@horror-tube/world-id": "workspace:*",
    "dotenv": "^18.0.3",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/pg": "^8.15.5",
    "tsx": "^4.23.15",
    "typescript": "7.0.2"
  }
}
