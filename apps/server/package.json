{
  "name": "@horror-tube/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "migrate": "tsx src/migrate-cli.ts",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@horror-tube/betting": "workspace:*",
    "@horror-tube/ens": "workspace:*",
    "@horror-tube/fight": "workspace:*",
    "@horror-tube/world-id": "workspace:*",
    "@mysten/sui": "^2.33.0",
    "@shinami/clients": "^0.12.0",
    "dotenv": "^18.0.3",
    "pg": "^8.16.3",
    "valibot": "^1.5.0",
    "viem": "^2.56.8"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/pg": "^8.15.5",
    "tsx": "^4.23.15",
    "typescript": "7.0.2"
  }
}
