{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "dependsOn": ["^build", "@horror-tube/server#check:env"],
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["PORT", "GAME_PORT"]
    },
    "test": {},
    "typecheck": {},
    "check:env": {
      "dependsOn": ["^build"],
      "cache": false,
      "passThroughEnv": ["GAME_PORT"]
    }
  }
}
